---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="hi">
 <head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
   body {
    background: linear-gradient(135deg, #0b0f19 0%, #1a1f29 100%);
    color: #f8fafc;
    font-family: 'Poppins', sans-serif;
    margin: 0;
   }
   /* Header Navigation */
   .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem;
    background-color: rgba(15, 23, 42, 0.9);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
   }
   .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #fbbf24;
    text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
   }
   .nav-links a {
    color: #cbd5e1;
    text-decoration: none;
    margin: 0 1rem;
    transition: color 0.3s ease;
   }
   .nav-links a:hover {
    color: #fbbf24;
   }
   main {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
   }
   /* Hero Section */
   .hero {
    text-align: center;
    margin-bottom: 5rem;
   }
   .hero h1 {
    font-size: 3.5rem;
    color: #fbbf24;
    margin-bottom: 1rem;
    text-shadow: 0 4px 10px rgba(251, 191, 36, 0.3);
   }
   .hero p {
    font-size: 1.2rem;
    color: #94a3b8;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
   }
   /* Services Section */
   .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
   }
   .service-card {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 15px;
    padding: 3rem;
    text-align: center;
    transition: all 0.4s ease;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
   }
   .service-card:hover {
    transform: translateY(-15px);
    background-color: #2D3748;
    border-color: #fbbf24;
    box-shadow: 0 20px 30px rgba(251, 191, 36, 0.2);
   }
   .service-card h3 {
    color: #38bdf8;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
    transition: color 0.3s ease;
   }
   .service-card:hover h3 {
    color: #fbbf24;
   }
   .service-card p {
    color: #64748b;
    font-size: 1rem;
    line-height: 1.6;
    transition: color 0.3s ease;
   }
   .service-card:hover p {
    color: #e2e8f0;
   }
  </style>
 </head>
 <body>
  <nav class="nav-bar">
   <div class="logo">✨ एस्ट्रोलॉजर गुरु मां ✨</div>
   <div class="nav-links">
    <a href="#">होम</a>
    <a href="#">About</a>
    <a href="#">पेज</a>
    <a href="#">सोशल मीडिया</a>
   </div>
  </nav>

  <main>
   <section class="hero">
    <h1>✨ दिव्य ज्योतिष केंद्र ✨</h1>
    <p>ग्रहों की चाल और सितारों की स्थिति से अपने भविष्य के रहस्य जानें। हम आपको सटीक और प्रामाणिक ज्योतिषीय मार्गदर्शन प्रदान करते हैं।</p>
   </section>

   <section class="services">
    <div class="service-card">
     <h3>कुंडली मिलान</h3>
     <p>विवाह और साझेदारी के लिए जन्म कुंडली का सटीक मिलान और गहन विश्लेषण।</p>
    </div>
    <div class="service-card">
     <h3>हस्तरेखा विज्ञान</h3>
     <p>हाथों की लकीरों में छुपे आपके भविष्य, करियर और स्वास्थ्य के संकेत।</p>
    </div>
    <div class="service-card">
     <h3>वास्तु शास्त्र</h3>
     <p>सुख, शांति और समृद्धि के लिए अपने घर या ऑफिस के वास्तु दोषों का निवारण।</p>
    </div>
   </section>
  </main>

  <Footer />
 </body>
</html>
