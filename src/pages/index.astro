---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="hi">
 <head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
   /* वेबसाइट का बैकग्राउंड और टेक्स्ट कलर */
   body {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
   }
   main {
    padding: 2rem;
    max-width: 1000px;
    margin: 0 auto;
   }
   
   /* मेन हेडिंग का डिज़ाइन */
   .hero {
    text-align: center;
    padding: 4rem 0;
    border-bottom: 2px solid #334155;
   }
   .hero h1 {
    font-size: 3rem;
    color: #fbbf24;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(251, 191, 36, 0.4);
   }
   .hero p {
    font-size: 1.2rem;
    color: #cbd5e1;
   }

   /* कार्ड्स का लेआउट */
   .services {
    display: flex;
    gap: 2rem;
    margin-top: 4rem;
    flex-wrap: wrap;
    justify-content: center;
   }
   
   /* अलग-अलग बॉक्स (कार्ड) का डिज़ाइन */
   .service-card {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2rem;
    width: 280px;
    text-align: center;
    transition: all 0.4s ease;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
   }
   
   /* जब कार्ड पर माउस जाएगा (Hover Effect) तो क्या होगा */
   .service-card:hover {
    transform: translateY(-10px);
    border-color: #fbbf24;
    background-color: #fbbf24; /* कार्ड पीला हो जाएगा */
    box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
   }
   
   /* Hover होने पर अंदर के टेक्स्ट का रंग बदलेगा */
   .service-card:hover h3, .service-card:hover p {
    color: #0f172a; 
   }

   .service-card h3 {
    color: #38bdf8;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    transition: color 0.3s ease;
   }
   .service-card p {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.5;
    transition: color 0.3s ease;
   }
  </style>
 </head>
 <body>
  <Header />
  <main>
   <section class="hero">
    <h1>✨ दिव्य ज्योतिष केंद्र ✨</h1>
    <p>ग्रहों की चाल और सितारों की स्थिति से अपने भविष्य के रहस्य जानें। हम आपको सटीक और प्रामाणिक ज्योतिषीय मार्गदर्शन प्रदान करते हैं।</p>
   </section>

   <section class="services">
    <!-- सर्विस कार्ड 1 -->
    <div class="service-card">
     <h3>कुंडली मिलान</h3>
     <p>विवाह और साझेदारी के लिए जन्म कुंडली का सटीक मिलान और गहन विश्लेषण।</p>
    </div>
    
    <!-- सर्विस कार्ड 2 -->
    <div class="service-card">
     <h3>हस्तरेखा विज्ञान</h3>
     <p>हाथों की लकीरों में छुपे आपके भविष्य, करियर और स्वास्थ्य के संकेत।</p>
    </div>
    
    <!-- सर्विस कार्ड 3 -->
    <div class="service-card">
     <h3>वास्तु शास्त्र</h3>
     <p>सुख, शांति और समृद्धि के लिए अपने घर या ऑफिस के वास्तु दोषों का निवारण।</p>
    </div>
   </section>
  </main>
  <Footer />
 </body>
</html>
